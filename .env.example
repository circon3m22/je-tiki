# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public catalog access (safe to expose only with the included RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase privileged backend access. Never prefix this variable with NEXT_PUBLIC_.
# Prefer a scoped sb_secret_ key. Legacy projects may temporarily use
# SUPABASE_SERVICE_ROLE_KEY instead; the server helper supports that fallback.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# YooKassa server integration
YOOKASSA_SHOP_ID=replace_me
YOOKASSA_SECRET_KEY=replace_me
YOOKASSA_RETURN_URL=http://localhost:3000/order/success

# YooKassa does not sign HTTP notifications with a shared webhook secret. The
# webhook handler authenticates each event by re-fetching the payment from API.

# Optional future CDEK API integration
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# Optional order notifications
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
